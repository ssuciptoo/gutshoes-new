APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.domain-anda.com
FRONTEND_URL=https://domain-anda.com
# Alamat toko untuk tautan email dan tujuan kembali dari Midtrans.
STOREFRONT_URL=https://domain-anda.com
CORS_ALLOWED_ORIGINS=https://domain-anda.com
SANCTUM_STATEFUL_DOMAINS=domain-anda.com,api.domain-anda.com

# Cookies are HTTPS-only and shared by the storefront and API subdomains.
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.domain-anda.com
SESSION_SAME_SITE=lax

# Email provider for production is chosen before go-live (docs/EMAIL_INFRASTRUCTURE.md).
# Any SMTP provider works; fill these from that provider's verified sending domain.
MAIL_MAILER=smtp
MAIL_HOST=<smtp host provider>
MAIL_PORT=587
MAIL_USERNAME=<smtp username>
MAIL_PASSWORD=<smtp key>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=orders@domain-anda.com
MAIL_FROM_NAME="GutShoes"

QUEUE_CONNECTION=redis

# Required: the app refuses to resolve Midtrans with the fake driver or an empty key in production.
MIDTRANS_DRIVER=http
MIDTRANS_SERVER_KEY=<key production>
MIDTRANS_CLIENT_KEY=<key production>
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/v1/transactions
MIDTRANS_API_URL=https://api.midtrans.com/v2
MIDTRANS_REDIRECT_BASE_URL=https://app.midtrans.com/snap/v4/redirection

# Login pelanggan (Clerk) — gunakan kunci instance production/staging, bukan kunci development.
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=
CLERK_JWT_KEY=
# Signing secret webhook (whsec_…), endpoint: https://<api>/api/v1/webhooks/clerk
CLERK_WEBHOOK_SECRET=
CLERK_AUTHORIZED_PARTIES=https://domain-anda.com
