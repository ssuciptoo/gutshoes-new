APP_NAME="GutShoes API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# IP/CIDR load balancer atau CDN di depan API (dipisah koma). Kosongkan bila API diakses langsung.
TRUSTED_PROXIES=
FRONTEND_URL=http://localhost:5173
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gutshoes
DB_USERNAME=gutshoes
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development/staging: Google SMTP + App Password.
# Production: Resend SMTP. See docs/EMAIL_INFRASTRUCTURE.md.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Wajib diisi: email tanpa pengirim ditolak dan job email pesanan gagal.
MAIL_FROM_ADDRESS=orders@gutshoes.test
MAIL_FROM_NAME="${APP_NAME}"

# Login pelanggan (Clerk). Ambil dari Clerk Dashboard > Configure > API keys.
CLERK_SECRET_KEY=
# Frontend API URL instance Clerk, mis. https://nama-app.clerk.accounts.dev
CLERK_FRONTEND_API_URL=
# Opsional: "JWKS Public Key" (PEM, baris baru ditulis \n) agar verifikasi token tanpa memanggil jaringan.
CLERK_JWT_KEY=
# Signing secret webhook (whsec_…), endpoint: https://<api>/api/v1/webhooks/clerk
CLERK_WEBHOOK_SECRET=
# Origin frontend yang boleh memakai token, dipisah koma (default: FRONTEND_URL).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
MIDTRANS_DRIVER=fake
MIDTRANS_SERVER_KEY=
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_API_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_REDIRECT_BASE_URL=https://app.sandbox.midtrans.com/snap/v4/redirection
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
BITESHIP_API_KEY=
RAJAONGKIR_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_API_KEY=
RAJAONGKIR_COURIERS=jne:sicepat:jnt:ninja:tiki:anteraja:pos
RAJAONGKIR_TIMEOUT=30

GUTSHOES_ADMIN_EMAIL=
GUTSHOES_ADMIN_NAME=
GUTSHOES_ADMIN_PASSWORD=
# V1: refund ditunda. true = pesanan lunas bisa dibatalkan + refund diproses lewat admin.
GUTSHOES_REFUNDS_ENABLED=false

SHIPPING_DRIVER=fake
# Shipping rates are cached to save provider quota; 0 disables.
SHIPPING_QUOTE_CACHE_MINUTES=15
# Re-check Midtrans for pending payments (safety net for missed webhooks).
PAYMENT_RECONCILE_AFTER_MINUTES=5
PAYMENT_RECONCILE_INTERVAL_MINUTES=10
PAYMENT_RECONCILE_BATCH_SIZE=50
TRACKING_DRIVER=fake
BITESHIP_URL=https://api.biteship.com
STOREFRONT_URL=http://localhost:5173
