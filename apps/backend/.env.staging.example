APP_KEY=
APP_URL=https://api-staging.domain-anda.com
FRONTEND_URL=https://staging.domain-anda.com
# Alamat toko untuk tautan email dan tujuan kembali dari Midtrans.
STOREFRONT_URL=https://staging.domain-anda.com
CORS_ALLOWED_ORIGINS=https://staging.domain-anda.com
SANCTUM_STATEFUL_DOMAINS=staging.domain-anda.com,api-staging.domain-anda.com

DB_CONNECTION=mysql
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=alamat-email-akun-brevo
MAIL_PASSWORD=brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@domain-anda.com
MAIL_FROM_NAME="GutShoes Staging"

MIDTRANS_DRIVER=http
MIDTRANS_SERVER_KEY=<key sandbox>
MIDTRANS_CLIENT_KEY=<key sandbox>
MIDTRANS_IS_PRODUCTION=false

SHIPPING_DRIVER=rajaongkir
TRACKING_DRIVER=rajaongkir
RAJAONGKIR_API_KEY=<key staging>
RAJAONGKIR_TIMEOUT=30

# Login pelanggan (Clerk) — gunakan kunci instance production/staging, bukan kunci development.
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=
CLERK_JWT_KEY=
# Signing secret webhook (whsec_…), endpoint: https://<api>/api/v1/webhooks/clerk
CLERK_WEBHOOK_SECRET=
CLERK_AUTHORIZED_PARTIES=https://staging.domain-anda.com
