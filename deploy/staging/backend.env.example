# Konfigurasi Laravel staging. Disalin ke /opt/gutshoes/backend.env oleh bootstrap.sh (permission 600).
# Domain, database, Redis, sesi, dan antrean sudah diatur di compose.yaml dari .env; jangan diisi di sini.
# Daftar lengkap variabel: apps/backend/.env.staging.example dan docs/STAGING_DEPLOYMENT.md.

APP_NAME=GutShoes
# Dibuat acak oleh bootstrap.sh. Jangan diganti setelah ada data: sesi dan token guest terenkripsi dengannya.
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Email (mis. Brevo). MAIL_FROM_ADDRESS wajib: tanpa pengirim semua email pesanan gagal.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="GutShoes Staging"

# Midtrans Sandbox (Dashboard sandbox > Settings > Access Keys).
MIDTRANS_DRIVER=http
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Ongkir & pelacakan.
SHIPPING_DRIVER=rajaongkir
TRACKING_DRIVER=rajaongkir
RAJAONGKIR_API_KEY=
RAJAONGKIR_TIMEOUT=30

# Clerk (instance yang sama dengan publishable key storefront).
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
