# Variabel Docker Compose staging. Disalin ke /opt/gutshoes/.env oleh bootstrap.sh (permission 600).
# Password MySQL/Redis dibuat acak oleh bootstrap.sh; jangan diganti setelah database terisi.

# Domain induk: toko di staging.<domain>, API di api-staging.<domain>. Wajib domain sungguhan.
STAGING_DOMAIN=domain-anda.com
# Email untuk notifikasi Let's Encrypt (sertifikat HTTPS).
ACME_EMAIL=admin@domain-anda.com

# Image dari GitHub Container Registry (workflow "Publish staging images").
BACKEND_IMAGE=ghcr.io/surega02/gutshoes-backend
STOREFRONT_IMAGE=ghcr.io/surega02/gutshoes-storefront
# "staging" = commit terakhir yang lulus CI; isi hash commit untuk mengunci/rollback.
IMAGE_TAG=staging
# Aktifkan setelah image storefront tersedia: COMPOSE_PROFILES=storefront
COMPOSE_PROFILES=

MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# 1 worker antrean cukup untuk VPS 1 vCPU / 2 GB.
HORIZON_MAX_PROCESSES=1
